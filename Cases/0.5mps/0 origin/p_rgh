FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325; // 0 대신 1기압(대기압)을 기본값으로 줌

boundaryField
{
    inlet  { type fixedFluxPressure; value uniform 101325; }
    outlet { type prghTotalPressure; p0 uniform 101325; rho rho; g g; value uniform 101325; }
    wall   { type fixedFluxPressure; value uniform 101325; }
}
