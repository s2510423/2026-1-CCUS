FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     CIPCFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         10.0;

deltaT          1e-05;

writeControl    runTime;

writeInterval   0.05;

writeFormat     ascii;

writePrecision  6;

compression     off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.05;
maxAlphaCo      0.05;
maxDeltaT       1e-04; // 💡 아까 온도 튀는 거 방지용 안전 브레이크

functions
{
    // 1. 벽면 최대 압력 트래킹 (실시간 로그 출력 강화)
    wallPressureMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        display         yes;
        log             yes; // 💡 터미널 창에 강제 중계 활성화
        location        yes;
        writeControl    timeStep;
        executeControl  timeStep;
        writeInterval   1;
        fields          (p_rgh);
    }

    // 2. 출구 물 질량 유량 (v2312 표준 문법으로 완벽 교체)
    outletWaterMass
    {
        type            surfaceFieldValue; // 💡 faceSource 대신 이걸 써야 안 튕김!
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        executeControl  timeStep;
        writeInterval   1;
        log             yes; // 💡 터미널에 스텝마다 출력 박기
        
        operation       sum;
        regionType      patch;
        name            outlet;            // 본인의 outlet 패치 이름 맞는지 꼭 확인!
        fields          (phi);

        writeFields     false;
    }
}allowSystemOperations true;

