FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-10;

boundaryField
{
    outlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    wall
    {
        type            nutkWallFunction;
        value           uniform 1e-10;
    }
    procBoundary4to0
    {
        type            processor;
        value           uniform 1e-10;
    }
    procBoundary4to5
    {
        type            processor;
        value           uniform 1e-10;
    }
}


