FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    slag
    {
        type            wallHeatTransfer;
        Tinf            uniform 1773;
        alphaWall       uniform 0;
        value           uniform 1773;
    }
    outlet
    {
        type            zeroGradient;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 350;
    }
    wall
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
