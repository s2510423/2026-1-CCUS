FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 300;

boundaryField
{
    inlet  { type fixedValue; value uniform 350; } // 대략 상온
    outlet { type zeroGradient; }
    wall   { type zeroGradient; }
    slag   { type fixedValue; value uniform 1773; } // 섭씨 약 1500도
}