FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.water;
}

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectFluid;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       18.0153;
    }
    thermodynamics
    {
        Cp              4180;
        Hf              0;
    }
    transport
    {
        mu              0.001;
        Pr              7.0;
    }
    equationOfState
    {
        R               3000;
        rho0            1000;
        p0              100000;
    }
}
